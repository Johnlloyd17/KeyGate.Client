@page "/devices"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer


<PageTitle>Devices — KeyGate Admin</PageTitle>

<h1>Connected Devices</h1>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <div class="row mb-4">
        @for (var i = 0; i < 4; i++)
        {
            <div class="col-md-3 col-6">
                <div class="card h-100 placeholder-glow">
                    <div class="card-body">
                        <div class="placeholder placeholder-sm col-6 mb-2" style="height:0.75rem;"></div>
                        <div class="placeholder placeholder-lg col-4 mb-2" style="height:1.75rem;"></div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="card mb-3 placeholder-glow">
        <div class="card-body py-2">
            <div class="row g-2">
                <div class="col-md-4"><div class="placeholder placeholder-sm col-12" style="height:2rem;"></div></div>
                <div class="col-md-2"><div class="placeholder placeholder-sm col-12" style="height:2rem;"></div></div>
                <div class="col-md-2"><div class="placeholder placeholder-sm col-12" style="height:2rem;"></div></div>
            </div>
        </div>
    </div>
    <div class="card placeholder-glow">
        <div class="card-body">
            @for (var r = 0; r < 6; r++)
            {
                <div class="placeholder placeholder-sm col-12 mb-2" style="height:1.5rem;"></div>
            }
        </div>
    </div>
}
else
{
<!-- Metric Cards -->
<div class="row mb-4">
    <div class="col-md-3 col-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Total Devices</div>
                <div class="fw-bold" style="font-size:1.75rem;">@_devices.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Unlocked</div>
                <div class="fw-bold" style="font-size:1.75rem; color:var(--kg-success);">@_devices.Count(d => d.Status == "Unlocked")</div>
                <div class="small text-muted">currently accessible</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Locked</div>
                <div class="fw-bold" style="font-size:1.75rem;">@_devices.Count(d => d.Status == "Locked")</div>
                <div class="small text-muted">secured</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Active Sessions</div>
                <div class="fw-bold" style="font-size:1.75rem;">@_devices.Count(d => d.CurrentIndividualName is not null)</div>
                <div class="small text-muted">someone signed in</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small">Search</label>
                <input class="form-control form-control-sm" type="search" placeholder="Device name, location…" @bind="_search" @bind:event="oninput" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Status</label>
                <select class="form-select form-select-sm" @bind="_filterStatus">
                    <option value="">All</option>
                    <option value="Unlocked">Unlocked</option>
                    <option value="Locked">Locked</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Session</label>
                <select class="form-select form-select-sm" @bind="_filterSession">
                    <option value="">All</option>
                    <option value="active">Active</option>
                    <option value="none">No session</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="ResetDeviceFilters"><i class="bi bi-x-lg"></i> Reset</button>
                <button class="btn btn-outline-primary btn-sm" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" @onclick:preventDefault>Columns</button>
                    <ul class="dropdown-menu p-2" style="min-width:200px;">
                        @foreach (var col in AllDeviceColumns)
                        {
                            <li>
                                <label class="dropdown-item d-flex align-items-center gap-2 mb-0">
                                    <input type="checkbox" class="form-check-input"
                                           checked="@_exportColumns.Contains(col.Key)"
                                           @onchange="() => ToggleExportColumn(col.Key)" />
                                    @col.Label
                                </label>
                            </li>
                        }
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <button class="dropdown-item small" @onclick="SelectAllColumns">Select all</button>
                        </li>
                        <li>
                            <button class="dropdown-item small" @onclick="() => _exportColumns.Clear()">Deselect all</button>
                        </li>
                    </ul>
                </div>
                <button class="btn btn-outline-success btn-sm" @onclick='() => ExportAsync("xlsx")'>Export</button>
                <label class="btn btn-outline-primary btn-sm mb-0">
                    Import
                    <InputFile class="d-none" OnChange="HandleImportFileSelected" accept=".xlsx,.csv" />
                </label>
            </div>
        </div>
    </div>
</div>

@if (_importResult is not null)
{
    <div class="alert @(_importResult.Errors.Count > 0 ? "alert-warning" : "alert-success") alert-dismissible">
        Imported @_importResult.Imported of @_importResult.TotalRows rows.
        @(_importResult.Skipped > 0 ? $"Skipped {_importResult.Skipped} duplicates." : "")
        @(_importResult.Errors.Count > 0 ? $"{_importResult.Errors.Count} validation error(s)." : "")
        <button type="button" class="btn-close" @onclick="() => _importResult = null"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Device Name</th>
                <th>Status</th>
                <th>Location</th>
                <th>Last seen</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (_filtered.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">No devices found.</td></tr>
            }
            @foreach (var device in _filtered)
            {
                <tr>
                    <td>
                        @if (_editingId == device.Id)
                        {
                            <input class="form-control form-control-sm" @bind="_editName" />
                        }
                        else
                        {
                            @device.DeviceName
                        }
                    </td>
                    <td>
                        @if (device.Status == "Unlocked")
                        {
                            <span class="badge text-bg-success status-badge">Unlocked</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary status-badge">Locked</span>
                        }
                    </td>
                    <td>
                        @if (_editingId == device.Id)
                        {
                            <input class="form-control form-control-sm" @bind="_editLocation" />
                        }
                        else
                        {
                            @(device.Location ?? "—")
                        }
                    </td>
                    <td>@device.LastSeenAt.ToLocalTime().ToString("g")</td>
                    <td class="text-end text-nowrap">
                        @if (_editingId == device.Id)
                        {
                            <button class="btn btn-sm btn-primary" title="Save" @onclick="() => SaveEditAsync(device.Id)"><i class="bi bi-check-lg"></i></button>
                            <button class="btn btn-sm btn-secondary ms-1" title="Cancel" @onclick="CancelEdit"><i class="bi bi-x-lg"></i></button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" title="Rename" @onclick="() => StartEdit(device)"><i class="bi bi-pencil"></i></button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
}

@code {
    [Inject] private AdminApiClient Api { get; set; } = default!;
    [Inject] private DeviceStatusListener Listener { get; set; } = default!;
    [Inject] private BrowserFileDownload Download { get; set; } = default!;

    private static readonly (string Key, string Label)[] AllDeviceColumns = new[]
    {
        ("DeviceName", "Device Name"),
        ("DeviceFingerprint", "Fingerprint"),
        ("Location", "Location"),
        ("Status", "Status")
    };

    private List<DeviceDto> _devices = new();
    private string _search = string.Empty;
    private string _filterStatus = string.Empty;
    private string _filterSession = string.Empty;
    private string? _error;
    private int? _editingId;
    private string _editName = string.Empty;
    private string? _editLocation;
    private ImportResult? _importResult;
    private HashSet<string> _exportColumns = AllDeviceColumns.Select(c => c.Key).ToHashSet();
    private bool _loading = true;

    private List<DeviceDto> _filtered
    {
        get
        {
            var query = _devices.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_search))
            {
                query = query.Where(d =>
                    d.DeviceName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (d.Location ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (d.CurrentIndividualName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_filterStatus))
                query = query.Where(d => d.Status == _filterStatus);

            if (_filterSession == "active")
                query = query.Where(d => d.CurrentIndividualName is not null);
            else if (_filterSession == "none")
                query = query.Where(d => d.CurrentIndividualName is null);

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
        try
        {
            await Listener.EnsureStartedAsync();
            Listener.DeviceStatusChanged += HandleDeviceStatusChanged;
        }
        catch
        {
            // SignalR is optional — the grid still works from the initial load + manual refresh.
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _devices = await Api.GetDevicesAsync();
            _error = null;
        }
        catch (KeyGateApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void StartEdit(DeviceDto device)
    {
        _editingId = device.Id;
        _editName = device.DeviceName;
        _editLocation = device.Location;
    }

    private void CancelEdit() => _editingId = null;

    private void ResetDeviceFilters()
    {
        _search = string.Empty;
        _filterStatus = string.Empty;
        _filterSession = string.Empty;
    }

    private async Task SaveEditAsync(int id)
    {
        try
        {
            var updated = await Api.UpdateDeviceAsync(id, _editName.Trim(), _editLocation);
            var index = _devices.FindIndex(d => d.Id == id);
            if (index >= 0)
            {
                _devices[index] = updated;
            }
            _editingId = null;
            _error = null;
        }
        catch (KeyGateApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void HandleDeviceStatusChanged(DeviceStatusChangedEvent @event)
    {
        InvokeAsync(() =>
        {
            var index = _devices.FindIndex(d => d.Id == @event.DeviceId);
            if (index >= 0)
            {
                _devices[index] = _devices[index] with
                {
                    DeviceName = @event.DeviceName,
                    Status = @event.Status,
                    CurrentIndividualName = @event.CurrentIndividualName
                };
            }
            else
            {
                _devices.Add(new DeviceDto(
                    @event.DeviceId,
                    @event.DeviceName,
                    string.Empty,
                    null,
                    @event.Status,
                    @event.ChangedAt,
                    null,
                    @event.CurrentIndividualName));
            }
            StateHasChanged();
        });
    }

    private async Task ExportAsync(string format)
    {
        try
        {
            var ext = format == "csv" ? "csv" : "xlsx";
            var contentType = format == "csv" ? "text/csv" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            var columns = _exportColumns.Count < AllDeviceColumns.Length ? _exportColumns : null;
            var bytes = await Api.ExportDevicesAsync(ext, columns);
            await Download.DownloadFileAsync($"devices_{DateTime.UtcNow:yyyyMMdd}.{ext}", bytes, contentType);
        }
        catch (KeyGateApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void ToggleExportColumn(string key)
    {
        if (!_exportColumns.Remove(key))
            _exportColumns.Add(key);
    }

    private void SelectAllColumns()
    {
        _exportColumns = AllDeviceColumns.Select(c => c.Key).ToHashSet();
    }

    private async Task HandleImportFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            _importResult = await Api.ImportDevicesAsync(ms, file.Name);
            await LoadAsync();
        }
        catch (KeyGateApiException ex)
        {
            _error = ex.Message;
        }
    }

}
