@page "/"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Dashboard — KeyGate Admin</PageTitle>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script src="/js/charts.js"></script>

<h1>Dashboard</h1>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <div class="row mb-4">
        @for (var i = 0; i < 4; i++)
        {
            <div class="col-md-3">
                <div class="card h-100 placeholder-glow">
                    <div class="card-body">
                        <div class="placeholder placeholder-sm col-6 mb-2" style="height:0.75rem;"></div>
                        <div class="placeholder placeholder-lg col-4 mb-2" style="height:1.75rem;"></div>
                        <div class="placeholder placeholder-sm col-8" style="height:0.75rem;"></div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Individuals</div>
                    <div class="fw-bold" style="font-size:1.75rem;">@_individualsCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Devices</div>
                    <div class="fw-bold" style="font-size:1.75rem;">@_devices.Count</div>
                    <div class="small" style="color:var(--kg-success);">@_devices.Count(d => d.Status == "Unlocked") unlocked</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Sessions (filtered)</div>
                    <div class="fw-bold" style="font-size:1.75rem;">@_sessions.Count</div>
                    <div class="small text-muted">@_sessions.Count(s => s.EndedAt is null) active</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Avg. Duration</div>
                    <div class="fw-bold" style="font-size:1.75rem;">@FormatDuration(_avgDuration)</div>
                    <div class="small text-muted">of completed sessions</div>
                </div>
            </div>
        </div>
    </div>
    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small">From</label>
                    <input type="date" class="form-control form-control-sm" @bind="_filterFrom" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">To</label>
                    <input type="date" class="form-control form-control-sm" @bind="_filterTo" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Device</label>
                    <select class="form-select form-select-sm" @bind="_filterDeviceId">
                        <option value="">All devices</option>
                        @foreach (var d in _devices)
                        {
                            <option value="@d.Id">@d.DeviceName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button class="btn btn-primary btn-sm" @onclick="ApplyFiltersAsync">Apply</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ResetFiltersAsync">Reset</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">Sessions per Device</div>
                <div class="card-body" style="position:relative;min-height:260px;">
                    <canvas id="chart-sessions-per-device"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-header">Device Status</div>
                <div class="card-body d-flex align-items-center justify-content-center" style="min-height:260px;">
                    <div style="max-width:220px;width:100%;">
                        <canvas id="chart-device-status"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-header">Individual Status</div>
                <div class="card-body d-flex align-items-center justify-content-center" style="min-height:260px;">
                    <div style="max-width:220px;width:100%;">
                        <canvas id="chart-individual-status"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 2 -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">Sessions Over Time (last 14 days)</div>
                <div class="card-body" style="position:relative;min-height:260px;">
                    <canvas id="chart-sessions-over-time"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-header">Session End Reasons</div>
                <div class="card-body d-flex align-items-center justify-content-center" style="min-height:260px;">
                    <div style="max-width:260px;width:100%;">
                        <canvas id="chart-end-reasons"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Device Table -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Devices</span>
            <button class="btn btn-sm btn-outline-primary" @onclick="LoadDataAsync">Refresh</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Device</th>
                            <th>Status</th>
                            <th>Location</th>
                            <th>Currently signed in</th>
                            <th>Last seen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_devices.Count == 0)
                        {
                            <tr><td colspan="5" class="text-muted">No devices have connected yet.</td></tr>
                        }
                        @foreach (var device in _devices)
                        {
                            <tr>
                                <td>@device.DeviceName</td>
                                <td>
                                    @if (device.Status == "Unlocked")
                                    {
                                        <span class="badge text-bg-success status-badge">Unlocked</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary status-badge">Locked</span>
                                    }
                                </td>
                                <td>@(device.Location ?? "—")</td>
                                <td>@(device.CurrentIndividualName ?? "—")</td>
                                <td>@device.LastSeenAt.ToLocalTime().ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private AdminApiClient Api { get; set; } = default!;
    [Inject] private DeviceStatusListener Listener { get; set; } = default!;

    private List<DeviceDto> _devices = new();
    private List<DashboardSession> _sessions = new();
    private int _individualsCount;
    private string? _error;
    private bool _loading = true;

    private DateTime? _filterFrom;
    private DateTime? _filterTo;
    private string _filterDeviceId = string.Empty;

    private double _avgDuration;
    private bool _shouldRenderCharts;

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today;
        _filterFrom = today.AddDays(-13);
        _filterTo = today;

        await LoadDataAsync();

        try
        {
            await Listener.EnsureStartedAsync();
            Listener.DeviceStatusChanged += HandleDeviceStatusChanged;
            Listener.IndividualChanged += HandleIndividualChanged;
            Listener.SessionChanged += HandleSessionChanged;
            Listener.DeviceChanged += HandleDeviceChanged;
        }
        catch
        {
            // SignalR is optional.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldRenderCharts)
        {
            _shouldRenderCharts = false;
            await RenderChartsAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var from = _filterFrom.HasValue ? _filterFrom.Value.Date.ToUniversalTime() : (DateTime?)null;
            var to = _filterTo.HasValue ? _filterTo.Value.Date.AddDays(1).AddTicks(-1).ToUniversalTime() : (DateTime?)null;

            var summary = await Api.GetDashboardSummaryAsync(from, to);

            _individualsCount = summary.GetProperty("individualsCount").GetInt32();

            _devices = summary.GetProperty("devices").EnumerateArray()
                .Select(d => new DeviceDto(
                    d.GetProperty("id").GetInt32(),
                    d.GetProperty("deviceName").GetString() ?? string.Empty,
                    string.Empty,
                    d.TryGetProperty("location", out var loc) && loc.ValueKind != System.Text.Json.JsonValueKind.Null ? loc.GetString() : null,
                    d.GetProperty("status").GetInt32() == 1 ? "Unlocked" : "Locked",
                    DateTime.Parse(d.GetProperty("lastSeenAt").GetString()!),
                    null,
                    d.TryGetProperty("currentIndividualName", out var cin) && cin.ValueKind != System.Text.Json.JsonValueKind.Null ? cin.GetString() : null))
                .ToList();

            _sessions = summary.GetProperty("sessions").EnumerateArray()
                .Select(s => new DashboardSession(
                    s.GetProperty("deviceName").GetString() ?? string.Empty,
                    DateTime.Parse(s.GetProperty("startedAt").GetString()!),
                    s.TryGetProperty("endedAt", out var ea) && ea.ValueKind != System.Text.Json.JsonValueKind.Null ? DateTime.Parse(ea.GetString()!) : (DateTime?)null,
                    s.TryGetProperty("durationSeconds", out var ds) && ds.ValueKind != System.Text.Json.JsonValueKind.Null ? ds.GetInt32() : (int?)null,
                    s.TryGetProperty("endReason", out var er) && er.ValueKind != System.Text.Json.JsonValueKind.Null ? er.GetString() : null))
                .ToList();

            var completed = _sessions.Where(s => s.DurationSeconds.HasValue).ToList();
            _avgDuration = completed.Count > 0 ? completed.Average(s => s.DurationSeconds!.Value) : 0;

            _error = null;
            _loading = false;

            _shouldRenderCharts = true;
        }
        catch (KeyGateApiException ex)
        {
            _error = ex.Message;
            _loading = false;
        }
    }

    private async Task ApplyFiltersAsync()
    {
        await LoadDataAsync();
    }

    private async Task ResetFiltersAsync()
    {
        var today = DateTime.Today;
        _filterFrom = today.AddDays(-13);
        _filterTo = today;
        _filterDeviceId = string.Empty;
        await LoadDataAsync();
    }

    private async Task RenderChartsAsync()
    {
        try
        {
            await RenderSessionsPerDeviceChart();
            await RenderDeviceStatusChart();
            await RenderSessionsOverTimeChart();
            await RenderEndReasonsChart();
        }
        catch
        {
            // Chart rendering is optional — UI still works without charts.
        }
    }

    private async Task RenderSessionsPerDeviceChart()
    {
        try
        {
            var grouped = _sessions
                .GroupBy(s => s.DeviceName)
                .Select(g => new { Label = g.Key, Count = g.Count() })
                .OrderByDescending(x => x.Count)
                .ToList();

            await JS.InvokeVoidAsync("createChart", "chart-sessions-per-device", new
            {
                type = "bar",
                data = new
                {
                    labels = grouped.Select(x => x.Label).ToArray(),
                    datasets = new[]
                    {
                        new
                        {
                            label = "Sessions",
                            data = grouped.Select(x => x.Count).ToArray(),
                            backgroundColor = "rgba(59,130,246,0.7)",
                            borderColor = "rgba(59,130,246,1)",
                            borderWidth = 1,
                            borderRadius = 4
                        }
                    }
                },
                options = new
                {
                    responsive = true,
                    maintainAspectRatio = false,
                    plugins = new { legend = new { display = false } },
                    scales = new
                    {
                        y = new { beginAtZero = true, ticks = new { stepSize = 1 } }
                    }
                }
            });
        }
        catch { }
    }

    private async Task RenderDeviceStatusChart()
    {
        try
        {
            var locked = _devices.Count(d => d.Status == "Locked");
            var unlocked = _devices.Count(d => d.Status == "Unlocked");

            await JS.InvokeVoidAsync("createChart", "chart-device-status", new
            {
                type = "doughnut",
                data = new
                {
                    labels = new[] { "Locked", "Unlocked" },
                    datasets = new[]
                    {
                        new
                        {
                            data = new[] { locked, unlocked },
                            backgroundColor = new[] { "#6c757d", "#198754" },
                            borderWidth = 0
                        }
                    }
                },
                options = new
                {
                    responsive = true,
                    maintainAspectRatio = true,
                    plugins = new
                    {
                        legend = new { position = "bottom", labels = new { padding = 12, font = new { size = 11 } } }
                    }
                }
            });
        }
        catch { }
    }

    private async Task RenderSessionsOverTimeChart()
    {
        try
        {
            var fromDate = _filterFrom ?? DateTime.Today.AddDays(-13);
            var toDate = _filterTo ?? DateTime.Today;

            var days = new List<DateTime>();
            for (var d = fromDate.Date; d <= toDate.Date; d = d.AddDays(1))
                days.Add(d);

            var countsByDay = _sessions
                .GroupBy(s => s.StartedAt.ToLocalTime().Date)
                .ToDictionary(g => g.Key, g => g.Count());

            var labels = days.Select(d => d.ToString("MMM dd")).ToArray();
            var data = days.Select(d => countsByDay.GetValueOrDefault(d, 0)).ToArray();

            await JS.InvokeVoidAsync("createChart", "chart-sessions-over-time", new
            {
                type = "line",
                data = new
                {
                    labels = labels,
                    datasets = new[]
                    {
                        new
                        {
                            label = "Sessions",
                            data = data,
                            borderColor = "rgba(59,130,246,1)",
                            backgroundColor = "rgba(59,130,246,0.1)",
                            fill = true,
                            tension = 0.3,
                            pointRadius = 3,
                            pointBackgroundColor = "rgba(59,130,246,1)"
                        }
                    }
                },
                options = new
                {
                    responsive = true,
                    maintainAspectRatio = false,
                    plugins = new { legend = new { display = false } },
                    scales = new
                    {
                        y = new { beginAtZero = true, ticks = new { stepSize = 1 } }
                    }
                }
            });
        }
        catch { }
    }

    private async Task RenderEndReasonsChart()
    {
        try
        {
            var reasons = _sessions
                .Where(s => s.EndReason is not null)
                .GroupBy(s => s.EndReason)
                .Select(g => new { Label = g.Key ?? "Unknown", Count = g.Count() })
                .OrderByDescending(x => x.Count)
                .ToList();

            if (reasons.Count == 0)
            {
                reasons.Add(new { Label = "No data", Count = 1 });
            }

            var colors = new[] { "#0d6efd", "#ffc107", "#dc3545", "#6c757d", "#198754", "#0dcaf0" };

            await JS.InvokeVoidAsync("createChart", "chart-end-reasons", new
            {
                type = "pie",
                data = new
                {
                    labels = reasons.Select(x => x.Label).ToArray(),
                    datasets = new[]
                    {
                        new
                        {
                            data = reasons.Select(x => x.Count).ToArray(),
                            backgroundColor = reasons.Select((_, i) => colors[i % colors.Length]).ToArray(),
                            borderWidth = 0
                        }
                    }
                },
                options = new
                {
                    responsive = true,
                    maintainAspectRatio = true,
                    plugins = new
                    {
                        legend = new { position = "bottom", labels = new { padding = 12, font = new { size = 11 } } }
                    }
                }
            });
        }
        catch { }
    }

    private static string FormatDuration(double totalSeconds)
    {
        if (totalSeconds < 60) return $"{(int)totalSeconds}s";
        var h = (int)(totalSeconds / 3600);
        var m = (int)((totalSeconds % 3600) / 60);
        return h > 0 ? $"{h}h {m}m" : $"{m}m";
    }

    private void HandleDeviceStatusChanged(DeviceStatusChangedEvent @event)
    {
        InvokeAsync(() =>
        {
            var existing = _devices.FirstOrDefault(d => d.Id == @event.DeviceId);
            if (existing is not null)
            {
                var index = _devices.IndexOf(existing);
                _devices[index] = existing with
                {
                    DeviceName = @event.DeviceName,
                    Status = @event.Status,
                    CurrentIndividualName = @event.CurrentIndividualName
                };
            }
            else
            {
                _devices.Add(new DeviceDto(
                    @event.DeviceId,
                    @event.DeviceName,
                    string.Empty,
                    null,
                    @event.Status,
                    @event.ChangedAt,
                    null,
                    @event.CurrentIndividualName));
            }
            _shouldRenderCharts = true;
            StateHasChanged();
        });
    }

    private void HandleIndividualChanged(IndividualChangedEvent @event)
    {
        InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    private void HandleSessionChanged(SessionChangedEvent @event)
    {
        InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    private void HandleDeviceChanged(DeviceChangedEvent @event)
    {
        InvokeAsync(async () =>
        {
            await LoadDataAsync();
            StateHasChanged();
        });
    }

    private record DashboardSession(string DeviceName, DateTime StartedAt, DateTime? EndedAt, int? DurationSeconds, string? EndReason);
}
