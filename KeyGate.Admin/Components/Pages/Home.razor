@page "/"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Dashboard — KeyGate Admin</PageTitle>

<h1>Dashboard</h1>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else
{
    <div class="row mb-3">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <div class="fs-3 fw-bold">@_devices.Count</div>
                    <div class="text-muted">Devices</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <div class="fs-3 fw-bold text-success">@_devices.Count(d => d.Status == "Unlocked")</div>
                    <div class="text-muted">Unlocked</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <div class="fs-3 fw-bold text-secondary">@_devices.Count(d => d.Status == "Locked")</div>
                    <div class="text-muted">Locked</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <div class="fs-3 fw-bold">@(_devices.Count(d => d.CurrentIndividualName is not null))</div>
                    <div class="text-muted">People signed in</div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Device</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Currently signed in</th>
                    <th>Last seen</th>
                </tr>
            </thead>
            <tbody>
                @if (_devices.Count == 0)
                {
                    <tr><td colspan="5" class="text-muted">No devices have connected yet.</td></tr>
                }
                @foreach (var device in _devices)
                {
                    <tr>
                        <td>@device.DeviceName</td>
                        <td>@(device.Location ?? "—")</td>
                        <td>
                            @if (device.Status == "Unlocked")
                            {
                                <span class="badge text-bg-success status-badge">Unlocked</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary status-badge">Locked</span>
                            }
                        </td>
                        <td>@(device.CurrentIndividualName ?? "—")</td>
                        <td>@device.LastSeenAt.ToLocalTime().ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Inject] private AdminApiClient Api { get; set; } = default!;
    [Inject] private DeviceStatusListener Listener { get; set; } = default!;

    private List<DeviceDto> _devices = new();
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadDevicesAsync();
        try
        {
            await Listener.EnsureStartedAsync();
            Listener.DeviceStatusChanged += HandleDeviceStatusChanged;
        }
        catch
        {
            // SignalR is optional — the grid still works from the initial load + refresh.
        }
    }

    private async Task LoadDevicesAsync()
    {
        try
        {
            _devices = await Api.GetDevicesAsync();
            _error = null;
        }
        catch (KeyGateApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void HandleDeviceStatusChanged(DeviceStatusChangedEvent @event)
    {
        InvokeAsync(() =>
        {
            var existing = _devices.FirstOrDefault(d => d.Id == @event.DeviceId);
            if (existing is not null)
            {
                var index = _devices.IndexOf(existing);
                _devices[index] = existing with
                {
                    DeviceName = @event.DeviceName,
                    Status = @event.Status,
                    CurrentIndividualName = @event.CurrentIndividualName
                };
            }
            else
            {
                _devices.Add(new DeviceDto(
                    @event.DeviceId,
                    @event.DeviceName,
                    string.Empty,
                    null,
                    @event.Status,
                    @event.ChangedAt,
                    null,
                    @event.CurrentIndividualName));
            }
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        Listener.DeviceStatusChanged -= HandleDeviceStatusChanged;
        await Listener.DisposeAsync();
    }
}
