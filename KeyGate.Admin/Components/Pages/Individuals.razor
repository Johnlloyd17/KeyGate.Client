@page "/individuals"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer


<style>
    main {
        min-width: 0;
        overflow-x: hidden;
    }
</style>

<PageTitle>Individuals — KeyGate Admin</PageTitle>

<h1>Registered Individuals</h1>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@if (_loading)
{
    <div class="row mb-4">
        @for (var i = 0; i < 4; i++)
        {
            <div class="col-md-3 col-6">
                <div class="card h-100 placeholder-glow">
                    <div class="card-body">
                        <div class="placeholder placeholder-sm col-6 mb-2" style="height:0.75rem;"></div>
                        <div class="placeholder placeholder-lg col-4 mb-2" style="height:1.75rem;"></div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="card mb-3 placeholder-glow">
        <div class="card-body py-2">
            <div class="row g-2">
                <div class="col-md-3"><div class="placeholder placeholder-sm col-12" style="height:2rem;"></div></div>
                <div class="col-md-2"><div class="placeholder placeholder-sm col-12" style="height:2rem;"></div></div>
                <div class="col-md-2"><div class="placeholder placeholder-sm col-12" style="height:2rem;"></div></div>
                <div class="col-md-2"><div class="placeholder placeholder-sm col-12" style="height:2rem;"></div></div>
            </div>
        </div>
    </div>
    <div class="card placeholder-glow">
        <div class="card-body">
            @for (var r = 0; r < 6; r++)
            {
                <div class="placeholder placeholder-sm col-12 mb-2" style="height:1.5rem;"></div>
            }
        </div>
    </div>
}
else
{
<!-- Metric Cards -->
<div class="row mb-4">
    <div class="col-md-3 col-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Total Individuals</div>
                <div class="fw-bold" style="font-size:1.75rem;">@_individuals.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Registered</div>
                <div class="fw-bold" style="font-size:1.75rem;">@_individuals.Count(i => i.Status == "Registered")</div>
                <div class="small text-muted">of @_individuals.Count total</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Male</div>
                <div class="fw-bold" style="font-size:1.75rem;">@_individuals.Count(i => i.Sex == "Male")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Female</div>
                <div class="fw-bold" style="font-size:1.75rem;">@_individuals.Count(i => i.Sex == "Female")</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Search</label>
                <input class="form-control form-control-sm" type="search" placeholder="Name, email/ID, service…" @bind="_search" @bind:event="oninput" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Sex</label>
                <select class="form-select form-select-sm" @bind="_filterSex">
                    <option value="">All</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Province</label>
                <select class="form-select form-select-sm" @bind="_filterProvince">
                    <option value="">All</option>
                    @foreach (var p in _provinces)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Status</label>
                <select class="form-select form-select-sm" @bind="_filterStatus">
                    <option value="">All</option>
                    <option value="Registered">Registered</option>
                    <option value="Pending">Pending</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="ResetIndividualFilters"><i class="bi bi-x-lg"></i> Reset</button>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" @onclick:preventDefault>Columns</button>
                    <ul class="dropdown-menu dropdown-menu-end p-2" style="min-width:200px;">
                        @foreach (var col in AllIndividualColumns)
                        {
                            <li>
                                <label class="dropdown-item d-flex align-items-center gap-2 mb-0">
                                    <input type="checkbox" class="form-check-input"
                                           checked="@_exportColumns.Contains(col.Key)"
                                           @onchange="() => ToggleExportColumn(col.Key)" />
                                    @col.Label
                                </label>
                            </li>
                        }
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <button class="dropdown-item small" @onclick="SelectAllColumns">Select all</button>
                        </li>
                        <li>
                            <button class="dropdown-item small" @onclick="() => _exportColumns.Clear()">Deselect all</button>
                        </li>
                    </ul>
                </div>
                <button class="btn btn-outline-success btn-sm" @onclick='() => ExportAsync("xlsx")' disabled="@_busy">Export</button>
                <label class="btn btn-outline-primary btn-sm mb-0">
                    Import
                    <InputFile class="d-none" OnChange="HandleImportFileSelected" accept=".xlsx,.csv" disabled="@_busy" />
                </label>
                <button class="btn btn-primary btn-sm" @onclick="ShowShareModal" disabled="@_busy">
                    <i class="bi bi-qr-code"></i> Share
                </button>
            </div>
        </div>
    </div>
</div>

@if (_importResult is not null)
{
    <div class="alert @(_importResult.Errors.Count > 0 ? "alert-warning" : "alert-success") alert-dismissible">
        Imported @_importResult.Imported of @_importResult.TotalRows rows.
        @(_importResult.Skipped > 0 ? $"Skipped {_importResult.Skipped} duplicates." : "")
        @(_importResult.Errors.Count > 0 ? $"{_importResult.Errors.Count} validation error(s)." : "")
        <button type="button" class="btn-close" @onclick="() => _importResult = null"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Sex</th>
                <th>Age</th>
                <th>Province</th>
                <th>City / Municipality</th>
                <th>Barangay</th>
                <th>Sectors</th>
                <th>Service Availed</th>
                <th>Date</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (_filtered.Count == 0)
            {
                <tr><td colspan="11" class="text-muted">No individuals found. Share the registration link to get started.</td></tr>
            }
            @foreach (var individual in _filtered)
            {
                var sectors = ParseSectors(individual.Sectors);
                <tr>
                    <td>@individual.Id</td>
                    <td>
                        @if (_editingId == individual.Id)
                        {
                            <input class="form-control form-control-sm" @bind="_editName" />
                        }
                        else
                        {
                            @individual.FullName
                        }
                    </td>
                    <td>
                        @if (_editingId == individual.Id)
                        {
                            <select class="form-select form-select-sm" @bind="_editSex">
                                <option value="">—</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        }
                        else
                        {
                            @(individual.Sex ?? "—")
                        }
                    </td>
                    <td>
                        @if (_editingId == individual.Id)
                        {
                            <input type="number" class="form-control form-control-sm" @bind="_editAge" min="1" max="150" />
                        }
                        else
                        {
                            @(individual.Age?.ToString() ?? "—")
                        }
                    </td>
                    <td>
                        @if (_editingId == individual.Id)
                        {
                            <input class="form-control form-control-sm" @bind="_editProvince" />
                        }
                        else
                        {
                            @(individual.Province ?? "—")
                        }
                    </td>
                    <td>
                        @if (_editingId == individual.Id)
                        {
                            <input class="form-control form-control-sm" @bind="_editCityMunicipality" />
                        }
                        else
                        {
                            @(individual.CityMunicipality ?? "—")
                        }
                    </td>
                    <td>
                        @if (_editingId == individual.Id)
                        {
                            <input class="form-control form-control-sm" @bind="_editBarangay" />
                        }
                        else
                        {
                            @(individual.Barangay ?? "—")
                        }
                    </td>
                    <td>
                        @if (_editingId == individual.Id)
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var sector in AllSectors)
                                {
                                    <label class="sector-check mb-0">
                                        <input type="checkbox" class="form-check-input"
                                               checked="@_editSectorsSet.Contains(sector)"
                                               @onchange="() => ToggleSector(sector)" />
                                        <span class="small">@sector</span>
                                    </label>
                                }
                            </div>
                        }
                        else if (sectors.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var sector in sectors)
                                {
                                    <span class="sector-badge">@sector</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @if (_editingId == individual.Id)
                        {
                            <input class="form-control form-control-sm" @bind="_editServiceAvailed" />
                        }
                        else
                        {
                            @(individual.ServiceAvailed ?? "—")
                        }
                    </td>
                    <td>@individual.CreatedAt.ToLocalTime().ToString("d")</td>
                    <td class="text-end text-nowrap">
                        @if (_editingId == individual.Id)
                        {
                            <button class="btn btn-sm btn-primary" title="Save" @onclick="() => SaveEditAsync(individual.Id)" disabled="@_busy"><i class="bi bi-check-lg"></i></button>
                            <button class="btn btn-sm btn-secondary ms-1" title="Cancel" @onclick="CancelEdit"><i class="bi bi-x-lg"></i></button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary ms-1" title="Edit" @onclick="() => StartEdit(individual)" disabled="@_busy"><i class="bi bi-pencil"></i></button>
                            <button class="btn btn-sm btn-outline-danger ms-1" title="Delete" @onclick="() => ConfirmDeleteAsync(individual)" disabled="@_busy"><i class="bi bi-trash"></i></button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_showShareModal)
{
    <div class="modal d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Share Registration Link</h5>
                    <button type="button" class="btn-close" @onclick="CloseShareModal"></button>
                </div>
                <div class="modal-body text-center">
                    <p class="text-muted mb-3">Share this link with individuals to let them register themselves.</p>
                    @if (_shareQrBase64 is not null)
                    {
                        <img class="qr-code" src="data:image/png;base64,@_shareQrBase64" alt="QR code" style="width:220px;height:220px;" />
                    }
                    <div class="mt-2 text-muted small" id="share-url-text">@_registrationUrl</div>
                    <div class="mt-3 d-flex gap-2 justify-content-center">
                        <button class="btn btn-primary" @onclick="PrintShareQrAsync">Print</button>
                        <button class="btn btn-outline-secondary" @onclick="CopyShareLinkAsync">Copy Link</button>
                        <button class="btn btn-outline-secondary" @onclick="ShareLinkAsync">Share</button>
                    </div>
                    @if (_copySuccess is not null)
                    {
                        <div class="text-success small mt-2">@_copySuccess</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseShareModal">Close</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

}

@code {
    [Inject] private AdminApiClient Api { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;
    [Inject] private IConfiguration Configuration { get; set; } = default!;
    [Inject] private BrowserFileDownload Download { get; set; } = default!;
    [Inject] private DeviceStatusListener Listener { get; set; } = default!;

    private static readonly string[] AllSectors = new[]
    {
        "Student", "Government Workforce", "PWD", "LGBTQ",
        "Sr. Citizens", "OSY", "Indigent", "Others"
    };

    private static readonly (string Key, string Label)[] AllIndividualColumns = new[]
    {
        ("FullName", "Full Name"),
        ("EmailOrEmployeeId", "Email / Employee ID"),
        ("Department", "Department"),
        ("Sex", "Sex"),
        ("Age", "Age"),
        ("Province", "Province"),
        ("CityMunicipality", "City / Municipality"),
        ("Barangay", "Barangay"),
        ("Student", "Student"),
        ("Gov't", "Gov't"),
        ("PWD", "PWD"),
        ("LGBTQ", "LGBTQ"),
        ("Sr. Citizens", "Sr. Citizens"),
        ("OSY", "OSY"),
        ("Indigent", "Indigent"),
        ("Others", "Others"),
        ("ServiceAvailed", "Service Availed"),
        ("Status", "Status")
    };

    private List<IndividualDto> _individuals = new();
    private string _search = string.Empty;
    private string _filterSex = string.Empty;
    private string _filterProvince = string.Empty;
    private string _filterStatus = string.Empty;
    private string? _error;
    private bool _busy;
    private bool _loading = true;

    private List<string> _provinces => _individuals
        .Where(i => !string.IsNullOrWhiteSpace(i.Province))
        .Select(i => i.Province!)
        .Distinct()
        .OrderBy(p => p)
        .ToList();

    private int? _editingId;
    private string _editName = string.Empty;
    private string _editEmail = string.Empty;
    private string? _editDepartment;
    private string? _editSex;
    private int? _editAge;
    private string? _editProvince;
    private string? _editCityMunicipality;
    private string? _editBarangay;
    private HashSet<string> _editSectorsSet = new();
    private string? _editServiceAvailed;

    private bool _showShareModal;
    private string? _registrationUrl;
    private string? _shareQrBase64;
    private string? _copySuccess;
    private ImportResult? _importResult;
    private HashSet<string> _exportColumns = AllIndividualColumns.Select(c => c.Key).ToHashSet();

    private List<IndividualDto> _filtered
    {
        get
        {
            var query = _individuals.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_search))
            {
                query = query.Where(i =>
                    i.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    i.EmailOrEmployeeId.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (i.Province ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (i.CityMunicipality ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (i.Barangay ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (i.ServiceAvailed ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_filterSex))
                query = query.Where(i => i.Sex == _filterSex);

            if (!string.IsNullOrWhiteSpace(_filterProvince))
                query = query.Where(i => i.Province == _filterProvince);

            if (!string.IsNullOrWhiteSpace(_filterStatus))
                query = query.Where(i => i.Status == _filterStatus);

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
        try
        {
            await Listener.EnsureStartedAsync();
            Listener.IndividualChanged += HandleIndividualChanged;
        }
        catch
        {
            // SignalR is optional — the grid still works from the initial load + manual refresh.
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _individuals = await Api.GetIndividualsAsync();
            _error = null;
        }
        catch (KeyGateApiException ex)
        {
            _error = ex.Message;
        }
    }

    private void StartEdit(IndividualDto individual)
    {
        _editingId = individual.Id;
        _editName = individual.FullName;
        _editEmail = individual.EmailOrEmployeeId;
        _editDepartment = individual.Department;
        _editSex = individual.Sex;
        _editAge = individual.Age;
        _editProvince = individual.Province;
        _editCityMunicipality = individual.CityMunicipality;
        _editBarangay = individual.Barangay;
        _editSectorsSet = ParseSectors(individual.Sectors).ToHashSet();
        _editServiceAvailed = individual.ServiceAvailed;
    }

    private void CancelEdit() => _editingId = null;

    private void ResetIndividualFilters()
    {
        _search = string.Empty;
        _filterSex = string.Empty;
        _filterProvince = string.Empty;
        _filterStatus = string.Empty;
    }

    private void ToggleSector(string sector)
    {
        if (!_editSectorsSet.Remove(sector))
        {
            _editSectorsSet.Add(sector);
        }
    }

    private async Task SaveEditAsync(int id)
    {
        _busy = true;
        try
        {
            var sectorsJson = _editSectorsSet.Count > 0
                ? System.Text.Json.JsonSerializer.Serialize(_editSectorsSet.OrderBy(s => s))
                : null;
            await Api.UpdateIndividualAsync(
                id, _editName.Trim(), _editEmail.Trim(), _editDepartment,
                _editSex, _editAge, _editProvince, _editCityMunicipality,
                _editBarangay, sectorsJson, _editServiceAvailed);
            _editingId = null;
            await LoadAsync();
        }
        catch (KeyGateApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmDeleteAsync(IndividualDto individual)
    {
        if (!await Js.InvokeAsync<bool>("confirm", $"Delete {individual.FullName}? This cannot be undone."))
        {
            return;
        }

        try
        {
            await Api.DeleteIndividualAsync(individual.Id);
            await LoadAsync();
        }
        catch (KeyGateApiException ex)
        {
            _error = ex.Message;
        }
    }

    private static List<string> ParseSectors(string? sectorsJson)
    {
        if (string.IsNullOrWhiteSpace(sectorsJson))
            return new();
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<List<string>>(sectorsJson) ?? new();
        }
        catch
        {
            return new();
        }
    }

    private async Task ShowShareModal()
    {
        _registrationUrl = $"{Configuration["KeyGateApi:BaseUrl"]?.TrimEnd('/') ?? "http://localhost:5000"}/register";
        _shareQrBase64 = await Api.GenerateQrPngBase64Async(_registrationUrl);
        _showShareModal = true;
    }

    private void CloseShareModal()
    {
        _showShareModal = false;
        _registrationUrl = null;
        _shareQrBase64 = null;
        _copySuccess = null;
    }

    private async Task PrintShareQrAsync()
    {
        if (_shareQrBase64 is not null)
        {
            try
            {
                await Js.InvokeVoidAsync("printQr", _shareQrBase64, "KeyGate Registration");
            }
            catch { }
        }
    }

    private async Task CopyShareLinkAsync()
    {
        if (_registrationUrl is not null)
        {
            try
            {
                await Js.InvokeVoidAsync("navigator.clipboard.writeText", _registrationUrl);
                _copySuccess = "Link copied!";
                StateHasChanged();
                await Task.Delay(2000);
                _copySuccess = null;
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task ShareLinkAsync()
    {
        if (_registrationUrl is not null)
        {
            try
            {
                var shareSupported = await Js.InvokeAsync<bool>("eval", "typeof navigator.share === 'function'");
                if (shareSupported)
                {
                    await Js.InvokeVoidAsync("navigator.share", new
                    {
                        title = "KeyGate Registration",
                        text = "Complete your KeyGate registration",
                        url = _registrationUrl
                    });
                }
                else
                {
                    await Js.InvokeVoidAsync("navigator.clipboard.writeText", _registrationUrl);
                    _copySuccess = "Link copied! (Share not supported on this browser)";
                    StateHasChanged();
                    await Task.Delay(2000);
                    _copySuccess = null;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task ExportAsync(string format)
    {
        _busy = true;
        try
        {
            var ext = format == "csv" ? "csv" : "xlsx";
            var contentType = format == "csv" ? "text/csv" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            var columns = _exportColumns.Count < AllIndividualColumns.Length ? _exportColumns : null;
            var bytes = await Api.ExportIndividualsAsync(ext, columns);
            await Download.DownloadFileAsync($"individuals_{DateTime.UtcNow:yyyyMMdd}.{ext}", bytes, contentType);
        }
        catch (KeyGateApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ToggleExportColumn(string key)
    {
        if (!_exportColumns.Remove(key))
            _exportColumns.Add(key);
    }

    private void SelectAllColumns()
    {
        _exportColumns = AllIndividualColumns.Select(c => c.Key).ToHashSet();
    }

    private async Task HandleImportFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        _busy = true;
        _error = null;
        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            _importResult = await Api.ImportIndividualsAsync(ms, file.Name);
            await LoadAsync();
        }
        catch (KeyGateApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void HandleIndividualChanged(IndividualChangedEvent @event)
    {
        InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

}
