@page "/login"
@attribute [AllowAnonymous]

<PageTitle>Sign in — KeyGate Admin</PageTitle>

<div class="login-container d-flex align-items-center justify-content-center">
    <div class="login-card card shadow">
        <div class="card-body p-4">
            <div class="login-brand mb-4">
                <div class="login-logo">
                    <span class="login-logo-text">K</span>
                </div>
                <span class="login-brand-name">KeyGate</span>
            </div>

            <h1 class="h5 mb-1 login-title">Sign in to Admin</h1>
            <p class="mb-4 login-subtitle">Manage your kiosk network</p>

            @if (Error == "invalid")
            {
                <div class="alert alert-danger py-2">Invalid email or password.</div>
            }
            @if (Error == "unreachable")
            {
                <div class="alert alert-danger py-2">Cannot reach the KeyGate API. Make sure the server is running, then try again.</div>
            }

            <form method="post" action="/signin">
                <input type="hidden" name="returnUrl" value="@(string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl)" />
                <div class="mb-3">
                    <label class="form-label login-label" for="email">Email</label>
                    <input class="form-control login-input" id="email" name="email" type="email" required autofocus />
                </div>
                <div class="mb-3">
                    <label class="form-label login-label" for="password">Password</label>
                    <div class="input-group">
                        <input class="form-control login-input" id="password" name="password" type="password" required />
                        <button class="btn login-toggle" type="button" id="togglePassword"
                                onclick="var p=document.getElementById('password');var i=document.getElementById('toggleIcon');if(p.type==='password'){p.type='text';i.className='bi bi-eye-slash'}else{p.type='password';i.className='bi bi-eye'}">
                            <i class="bi bi-eye" id="toggleIcon"></i>
                        </button>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100" style="margin-top:var(--kg-space-2);">Sign in</button>
            </form>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
