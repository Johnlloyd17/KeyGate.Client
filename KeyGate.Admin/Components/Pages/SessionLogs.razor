@page "/sessions"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Sessions — KeyGate Admin</PageTitle>

<h1>Session Logs</h1>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

<!-- Metric Cards -->
<div class="row mb-4">
    <div class="col-md-3 col-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Total Sessions</div>
                <div class="fw-bold" style="font-size:1.75rem;">@_sessions.Count</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Active</div>
                <div class="fw-bold" style="font-size:1.75rem; color:var(--kg-success);">@_sessions.Count(s => s.EndedAt is null)</div>
                <div class="small text-muted">in progress</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Completed</div>
                <div class="fw-bold" style="font-size:1.75rem;">@_sessions.Count(s => s.EndedAt is not null)</div>
                <div class="small text-muted">ended sessions</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted" style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;">Avg. Duration</div>
                <div class="fw-bold" style="font-size:1.75rem;">@FormatDuration(_avgDuration)</div>
                <div class="small text-muted">of completed</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Individual</label>
                <select class="form-select form-select-sm" @bind="_selectedIndividualId">
                    <option value="">All</option>
                    @foreach (var individual in _individuals)
                    {
                        <option value="@individual.Id">@individual.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Device</label>
                <select class="form-select form-select-sm" @bind="_selectedDeviceId">
                    <option value="">All</option>
                    @foreach (var device in _devices)
                    {
                        <option value="@device.Id">@device.DeviceName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">From</label>
                <input type="date" class="form-control form-control-sm" @bind="_fromDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">To</label>
                <input type="date" class="form-control form-control-sm" @bind="_toDate" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button class="btn btn-primary btn-sm" @onclick="ApplyFiltersAsync" disabled="@_busy">Apply</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="ResetFiltersAsync">Reset</button>
            </div>
        </div>
    </div>
</div>

<div class="mb-2 d-flex justify-content-between align-items-center">
    <span class="text-muted">@_sessions.Count session(s) shown</span>
    <div class="d-flex gap-2 align-items-center">
        <div class="dropdown">
            <button class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" @onclick:preventDefault>Columns</button>
            <ul class="dropdown-menu dropdown-menu-end p-2" style="min-width:200px;">
                @foreach (var col in AllSessionColumns)
                {
                    <li>
                        <label class="dropdown-item d-flex align-items-center gap-2 mb-0">
                            <input type="checkbox" class="form-check-input"
                                   checked="@_exportColumns.Contains(col.Key)"
                                   @onchange="() => ToggleExportColumn(col.Key)" />
                            @col.Label
                        </label>
                    </li>
                }
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <button class="dropdown-item small" @onclick="SelectAllColumns">Select all</button>
                </li>
                <li>
                    <button class="dropdown-item small" @onclick="() => _exportColumns.Clear()">Deselect all</button>
                </li>
            </ul>
        </div>
        <button class="btn btn-outline-success btn-sm" @onclick='() => ExportAsync("xlsx")' disabled="@(_sessions.Count == 0)">Export</button>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Device</th>
                <th>User</th>
                <th>Status</th>
                <th>Started</th>
                <th>Duration</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (_sessions.Count == 0)
            {
                <tr><td colspan="6" class="text-muted">No sessions found.</td></tr>
            }
            @foreach (var session in _sessions)
            {
                <tr>
                    <td>@session.DeviceName</td>
                    <td>@session.IndividualName</td>
                    <td>
                        @if (session.EndedAt is null)
                        {
                            <span class="badge text-bg-success status-badge">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary status-badge">Completed</span>
                        }
                    </td>
                    <td>@session.StartedAt.ToLocalTime().ToString("g")</td>
                    <td>@(session.DurationSeconds.HasValue ? FormatDuration(session.DurationSeconds.Value) : "—")</td>
                    <td class="text-end text-nowrap">
                        @if (session.EndedAt is not null && session.EndReason is not null)
                        {
                            <span class="text-muted small">@session.EndReason</span>
                        }
                        else if (session.EndedAt is null)
                        {
                            <span class="text-muted small">In progress</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Inject] private AdminApiClient Api { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;
    [Inject] private DeviceStatusListener Listener { get; set; } = default!;
    [Inject] private BrowserFileDownload Download { get; set; } = default!;

    private static readonly (string Key, string Label)[] AllSessionColumns = new[]
    {
        ("Device", "Device"),
        ("User", "User"),
        ("Status", "Status"),
        ("Started", "Started"),
        ("Duration", "Duration"),
        ("EndReason", "End Reason")
    };

    private List<IndividualDto> _individuals = new();
    private List<DeviceDto> _devices = new();
    private List<SessionDto> _sessions = new();
    private string? _error;
    private bool _busy;
    private double _avgDuration;
    private HashSet<string> _exportColumns = AllSessionColumns.Select(c => c.Key).ToHashSet();

    private string _selectedIndividualId = string.Empty;
    private string _selectedDeviceId = string.Empty;
    private DateTime? _fromDate;
    private DateTime? _toDate;

    private int? SelectedIndividualId =>
        int.TryParse(_selectedIndividualId, out var id) ? id : null;

    private int? SelectedDeviceId =>
        int.TryParse(_selectedDeviceId, out var id) ? id : null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _individuals = await Api.GetIndividualsAsync();
            _devices = await Api.GetDevicesAsync();
            await ApplyFiltersAsync();
        }
        catch (KeyGateApiException ex)
        {
            _error = ex.Message;
        }

        try
        {
            await Listener.EnsureStartedAsync();
            Listener.SessionChanged += HandleSessionChanged;
        }
        catch
        {
            // SignalR is optional.
        }
    }

    private async Task ApplyFiltersAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var from = _fromDate.HasValue ? _fromDate.Value.ToUniversalTime() : (DateTime?)null;
            var to = _toDate.HasValue ? _toDate.Value.Date.AddDays(1).ToUniversalTime() : (DateTime?)null;

            _sessions = await Api.GetSessionsAsync(SelectedIndividualId, SelectedDeviceId, from, to);

            var completed = _sessions.Where(s => s.DurationSeconds.HasValue).ToList();
            _avgDuration = completed.Count > 0 ? completed.Average(s => s.DurationSeconds!.Value) : 0;
        }
        catch (KeyGateApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResetFiltersAsync()
    {
        _selectedIndividualId = string.Empty;
        _selectedDeviceId = string.Empty;
        _fromDate = null;
        _toDate = null;
        await ApplyFiltersAsync();
    }

    private static string FormatDuration(double totalSeconds)
    {
        if (totalSeconds < 60) return $"{(int)totalSeconds}s";
        var h = (int)(totalSeconds / 3600);
        var m = (int)((totalSeconds % 3600) / 60);
        return h > 0 ? $"{h}h {m}m" : $"{m}m";
    }

    private async Task ExportAsync(string format)
    {
        _busy = true;
        _error = null;
        try
        {
            var ext = format == "csv" ? "csv" : "xlsx";
            var contentType = format == "csv" ? "text/csv" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            var columns = _exportColumns.Count < AllSessionColumns.Length ? _exportColumns : null;
            var bytes = await Api.ExportSessionsAsync(ext, columns);
            await Download.DownloadFileAsync($"sessions_{DateTime.UtcNow:yyyyMMdd}.{ext}", bytes, contentType);
        }
        catch (KeyGateApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void ToggleExportColumn(string key)
    {
        if (!_exportColumns.Remove(key))
            _exportColumns.Add(key);
    }

    private void SelectAllColumns()
    {
        _exportColumns = AllSessionColumns.Select(c => c.Key).ToHashSet();
    }

    private void HandleSessionChanged(SessionChangedEvent @event)
    {
        InvokeAsync(async () =>
        {
            await ApplyFiltersAsync();
            StateHasChanged();
        });
    }

    public async ValueTask DisposeAsync()
    {
        Listener.SessionChanged -= HandleSessionChanged;
        await Listener.DisposeAsync();
    }
}
