<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KeyGate.Client.ViewModels"
             x:Class="KeyGate.Client.Views.LockScreenPage"
             x:DataType="vm:LockScreenViewModel"
             BackgroundColor="Black">

    <Grid>
        <Image Source="{Binding BackgroundImage}"
               Aspect="AspectFill"
               IsVisible="{Binding IsLocked}"
               SemanticProperties.Description="Lock screen background" />

        <Grid BackgroundColor="#B3000000">

            <!-- Logo top-left -->
            <Image Source="{Binding LogoImage}"
                   HeightRequest="48"
                   WidthRequest="48"
                   HorizontalOptions="Start"
                   VerticalOptions="Start"
                   Margin="32,32,0,0"
                   IsVisible="{Binding IsLocked}"
                   SemanticProperties.Description="KeyGate logo" />

            <!-- Title + Subtitle center -->
            <VerticalStackLayout
                IsVisible="{Binding IsLocked}"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                MaximumWidthRequest="480"
                Padding="40,0">

                <Label Text="{Binding Title}"
                       FontSize="36"
                       FontFamily="OpenSansSemibold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       SemanticProperties.HeadingLevel="Level1" />

                <Label Text="{Binding Subtitle}"
                       FontSize="15"
                       TextColor="#B3FFFFFF"
                       HorizontalTextAlignment="Center"
                       SemanticProperties.Description="Subtitle" />
            </VerticalStackLayout>

            <!-- Key input + Unlock button bottom-right -->
            <Grid IsVisible="{Binding IsLocked}"
                  VerticalOptions="End"
                  HorizontalOptions="End"
                  Padding="0,0,48,48"
                  MaximumWidthRequest="400">

                <VerticalStackLayout Spacing="12">
                    <Entry Text="{Binding KeyEntry}"
                           Placeholder="Access key"
                           IsPassword="True"
                           MaxLength="12"
                           Keyboard="Numeric"
                           FontSize="18"
                           HorizontalTextAlignment="Center"
                           BackgroundColor="White"
                           TextColor="Black"
                           PlaceholderColor="#94A3B8"
                           WidthRequest="280"
                           TextChanged="OnKeyEntryTextChanged"
                           ReturnCommand="{Binding UnlockCommand}"
                           ReturnCommandParameter="True" />

                    <Button Text="Unlock"
                            Command="{Binding UnlockCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            FontSize="16"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            WidthRequest="280"
                            CornerRadius="8" />

                    <Label Text="{Binding StatusMessage}"
                           FontSize="13"
                           TextColor="#FCD34D"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Success modal (shown briefly before minimize to tray) -->
            <Grid IsVisible="{Binding IsSuccessVisible}"
                  BackgroundColor="#99000000"
                  VerticalOptions="Fill"
                  HorizontalOptions="Fill">

                <Frame CornerRadius="16"
                       BackgroundColor="#1A1A2E"
                       WidthRequest="380"
                       Padding="40,48"
                       VerticalOptions="Center"
                       HorizontalOptions="Center">

                    <VerticalStackLayout Spacing="20" HorizontalOptions="Center">

                        <!-- Checkmark circle -->
                        <Frame WidthRequest="72"
                              HeightRequest="72"
                              HorizontalOptions="Center"
                              BackgroundColor="#16A34A"
                              CornerRadius="36"
                              Padding="0">
                            <Label Text="&#x2713;"
                                   FontSize="36"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>

                        <Label Text="Unlocked Successfully"
                               FontSize="24"
                               FontFamily="OpenSansSemibold"
                               TextColor="White"
                               HorizontalTextAlignment="Center" />

                        <Label Text="{Binding UserName, StringFormat='Welcome, {0}'}"
                               FontSize="16"
                               TextColor="#B3FFFFFF"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Minimizing to tray..."
                               FontSize="13"
                               TextColor="#66FFFFFF"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Unlocked state (fallback when not minimizing) -->
            <VerticalStackLayout
                IsVisible="{Binding IsUnlocked}"
                Padding="40,0"
                Spacing="16"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                MaximumWidthRequest="520">

                <Label Text="This computer is unlocked"
                       FontSize="28"
                       FontFamily="OpenSansSemibold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       SemanticProperties.HeadingLevel="Level1" />

                <Label Text="{Binding UserName, StringFormat='Welcome, {0}'}"
                       FontSize="18"
                       TextColor="#B3FFFFFF"
                       HorizontalTextAlignment="Center" />

                <Button Text="Lock"
                        Command="{Binding LockCommand}"
                        FontSize="16"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        CornerRadius="8"
                        HorizontalOptions="Center"
                        WidthRequest="200" />
            </VerticalStackLayout>
        </Grid>

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding NotifyActivityCommand}" />
        </Grid.GestureRecognizers>
    </Grid>

</ContentPage>
